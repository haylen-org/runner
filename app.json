{
    "name": "Haylen Runner",
    "identifier": "com.haylen.runner",
    "version": "1.0.0",
    "orientation": "any",
    "window": {
        "title": "Haylen Runner",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "highDpi": true
    },
    "design": {
        "width": 1280,
        "height": 820,
        "scaling": "none"
    },
    "ui": {
        "scaleMode": "physical"
    },
    "clearColor": "#FF07112F",
    "splash": {
        "logo": "logo.png",
        "background": "#FF07112F"
    },
    "plugins": {
        "qr-scanner": {
            "cameraUsage": "Haylen Runner reads the address of an app from a QR code."
        }
    }
}
